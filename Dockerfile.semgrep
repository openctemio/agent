# syntax=docker/dockerfile:1.7
# =============================================================================
# OpenCTEM Sensor - Semgrep (SAST)
# =============================================================================
# Lightweight image with Sensor + Semgrep only (~400MB)
#
# Build:
#   docker build -f Dockerfile.semgrep -t openctemio/sensor:semgrep .
#
# Usage:
#   docker run --rm -v $(pwd):/scan openctemio/sensor:semgrep \
#       -tool semgrep -target /scan -push
#
# =============================================================================

# -----------------------------------------------------------------------------
# Stage: Build Go binary
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/golang:1.26-alpine AS builder

# hadolint ignore=DL3018
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src
COPY . /src

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath \
    -ldflags="-w -s -X main.Version=${VERSION}" \
    -o /out/openctemio-sensor \
    .

# -----------------------------------------------------------------------------
# Stage: Install Semgrep
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/python:3.12-slim AS tool

# Pinned with its whole dependency set in docker/semgrep-constraints.txt (see
# the main Dockerfile: semgrep 1.93.0 broke on setuptools >= 81).
ARG SEMGREP_VERSION=1.178.0

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

COPY docker/semgrep-constraints.txt /tmp/semgrep-constraints.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --constraint /tmp/semgrep-constraints.txt "semgrep==${SEMGREP_VERSION}" \
    && semgrep --version

# -----------------------------------------------------------------------------
# Final: Sensor + Semgrep
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/python:3.12-slim

LABEL org.opencontainers.image.title="OpenCTEM Sensor - Semgrep"
LABEL org.opencontainers.image.description="Security scanning sensor with Semgrep SAST"
LABEL org.opencontainers.image.source="https://github.com/openctemio/sensor"

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy semgrep from tool stage
COPY --from=tool /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=tool /usr/local/bin/*semgrep* /usr/local/bin/

# Copy sensor binary
COPY --from=builder /out/openctemio-sensor /usr/local/bin/openctemio-sensor
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo

# CI-friendly git config
RUN git config --global --add safe.directory '*'

ENV CI=true
WORKDIR /github/workspace
ENTRYPOINT ["/usr/local/bin/openctemio-sensor"]
CMD ["-tool", "semgrep", "--help"]
