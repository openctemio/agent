# syntax=docker/dockerfile:1.7
# =============================================================================
# OpenCTEM Sensor - Nuclei (DAST)
# =============================================================================
# Sensor + Nuclei binary + a pre-baked nuclei-templates set so validation works
# out-of-the-box. Bundling the templates adds their on-disk size (a few hundred
# MB extracted) to the ~100MB base — a deliberate trade so a fresh `validate:nuclei`
# returns a real verdict instead of `inconclusive` while it waits on a network
# clone that its 30s template-installed check can't finish.
#
# Build:
#   docker build -f Dockerfile.nuclei -t openctemio/sensor:nuclei .
#
# Usage:
#   docker run --rm openctemio/sensor:nuclei \
#       -tool nuclei -target https://example.com -push
#
# =============================================================================

# -----------------------------------------------------------------------------
# Stage: Build Go binary
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/golang:1.26-alpine AS builder

# hadolint ignore=DL3018
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src
COPY . /src

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath \
    -ldflags="-w -s -X main.Version=${VERSION}" \
    -o /out/openctemio-sensor \
    .

# -----------------------------------------------------------------------------
# Stage: Download Nuclei
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/debian:bookworm-slim AS tool

ARG TARGETARCH
ARG NUCLEI_VERSION=3.4.1

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN set -eux; \
    case "${TARGETARCH}" in \
    amd64) NUCLEI_ARCH="amd64" ;; \
    arm64) NUCLEI_ARCH="arm64" ;; \
    *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_${NUCLEI_ARCH}.zip" \
    -o /tmp/nuclei.zip; \
    unzip /tmp/nuclei.zip -d /usr/local/bin; \
    rm /tmp/nuclei.zip; \
    chmod +x /usr/local/bin/nuclei

# Pre-download nuclei-templates so the published image can validate on first use.
# The sensor's re-verify (sdk-go nuclei.ValidateSingleTemplate) runs a template
# lookup — `nuclei -tl -id <sig> -disable-update-check`, bounded to 30s — before
# it will run a template. With -disable-update-check nuclei never auto-fetches,
# so without a baked template set that lookup finds nothing and validate:nuclei
# returns `inconclusive` instead of a real verdict. `-update-templates` writes the
# templates to $HOME/nuclei-templates AND the directory/version bookkeeping to
# $HOME/.config/nuclei, which is what makes `-tl` resolve at runtime. Templates
# are arch-independent and this stage runs natively per arch in CI (no QEMU), so
# executing nuclei here to fetch the release zip is safe.
ENV HOME=/root
RUN set -eux; \
    /usr/local/bin/nuclei -update-templates -no-color; \
    test -d /root/nuclei-templates; \
    test -n "$(ls -A /root/nuclei-templates)"

# -----------------------------------------------------------------------------
# Final: Sensor + Nuclei
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/debian:bookworm-slim

LABEL org.opencontainers.image.title="OpenCTEM Sensor - Nuclei"
LABEL org.opencontainers.image.description="Security scanning sensor with Nuclei DAST"
LABEL org.opencontainers.image.source="https://github.com/openctemio/agent"

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy nuclei from tool stage
COPY --from=tool /usr/local/bin/nuclei /usr/local/bin/

# Bake in the nuclei-templates fetched in the tool stage so validate:nuclei has
# a template set at first run. HOME must match where they were installed
# (/root/nuclei-templates) so nuclei's config resolves the directory at runtime;
# the sensor runs as root and inherits this HOME when it invokes nuclei.
ENV HOME=/root
COPY --from=tool /root/nuclei-templates /root/nuclei-templates
COPY --from=tool /root/.config/nuclei /root/.config/nuclei

# Copy sensor binary
COPY --from=builder /out/openctemio-sensor /usr/local/bin/openctemio-sensor
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# CI-friendly git config
RUN git config --global --add safe.directory '*'

ENV CI=true
WORKDIR /github/workspace
ENTRYPOINT ["/usr/local/bin/openctemio-sensor"]
CMD ["-tool", "nuclei", "--help"]
