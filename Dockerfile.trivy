# syntax=docker/dockerfile:1.7
# =============================================================================
# OpenCTEM Sensor - Trivy (SCA/IaC/Container)
# =============================================================================
# Lightweight image with Sensor + Trivy only (~100MB without DB, ~500MB with DB)
#
# Build:
#   # Without pre-loaded DB (downloads on first run)
#   docker build -f Dockerfile.trivy -t openctemio/sensor:trivy .
#
#   # With pre-loaded DB (faster CI, larger image)
#   docker build -f Dockerfile.trivy --target trivy-ci -t openctemio/sensor:trivy-ci .
#
# Usage:
#   docker run --rm -v $(pwd):/scan openctemio/sensor:trivy \
#       -tool trivy -target /scan -push
#
# =============================================================================

# -----------------------------------------------------------------------------
# Stage: Build Go binary
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS builder

# hadolint ignore=DL3018
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /src
COPY . /src

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath \
    -ldflags="-w -s -X main.Version=${VERSION}" \
    -o /out/openctemio-sensor \
    .

# -----------------------------------------------------------------------------
# Stage: Download Trivy
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS tool

ARG TARGETARCH
ARG TRIVY_VERSION=0.75.0

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN set -eux; \
    case "${TARGETARCH}" in \
    amd64) TRIVY_ARCH="64bit" ;; \
    arm64) TRIVY_ARCH="ARM64" ;; \
    *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    cd /tmp; \
    # Verify the archive against the release's checksums file before extracting
    # (same supply-chain check as the main Dockerfile): a tampered archive fails
    # sha256sum -c and aborts the build.
    TRIVY_ARCHIVE="trivy_${TRIVY_VERSION}_Linux-${TRIVY_ARCH}.tar.gz"; \
    curl -fsSL -o "${TRIVY_ARCHIVE}" \
        "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/${TRIVY_ARCHIVE}"; \
    curl -fsSL -o trivy-checksums.txt \
        "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_checksums.txt"; \
    grep " ${TRIVY_ARCHIVE}\$" trivy-checksums.txt | sha256sum -c -; \
    tar -xzf "${TRIVY_ARCHIVE}" -C /usr/local/bin trivy; \
    chmod +x /usr/local/bin/trivy; \
    rm -f "${TRIVY_ARCHIVE}" trivy-checksums.txt

# -----------------------------------------------------------------------------
# Stage: Trivy with pre-downloaded DB
# -----------------------------------------------------------------------------
FROM tool AS tool-with-db

ENV TRIVY_CACHE_DIR=/root/.cache/trivy
RUN trivy image --download-db-only --no-progress

# -----------------------------------------------------------------------------
# Target: trivy (without pre-loaded DB)
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS trivy

LABEL org.opencontainers.image.title="OpenCTEM Sensor - Trivy"
LABEL org.opencontainers.image.description="Security scanning sensor with Trivy SCA/IaC/Container"
LABEL org.opencontainers.image.source="https://github.com/openctemio/sensor"

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy trivy from tool stage
COPY --from=tool /usr/local/bin/trivy /usr/local/bin/

# Copy sensor binary
COPY --from=builder /out/openctemio-sensor /usr/local/bin/openctemio-sensor
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Non-root. uid/gid 1001 is the GitHub-hosted runner's user, which owns the
# checked-out workspace mounted at /github/workspace, so git's ownership
# check passes and reports can be written there. git trusts exactly that
# path (system config), not every directory ('*'). Elsewhere, run the
# container as the workspace owner (docker run --user "$(id -u):$(id -g)",
# GitLab: image:docker:user) or trust the checkout for the job, e.g.
# GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$CI_PROJECT_DIR".
RUN groupadd -g 1001 openctem && useradd -u 1001 -g openctem -d /home/openctem -m openctem \
    && git config --system --add safe.directory /github/workspace \
    && mkdir -p /github/workspace && chown openctem:openctem /github/workspace

ENV HOME=/home/openctem

ENV TRIVY_NO_PROGRESS=true
ENV CI=true
USER openctem
WORKDIR /github/workspace
ENTRYPOINT ["/usr/local/bin/openctemio-sensor"]
CMD ["-tool", "trivy", "--help"]

# -----------------------------------------------------------------------------
# Target: trivy-ci (with pre-loaded DB for faster CI)
# -----------------------------------------------------------------------------
FROM public.ecr.aws/docker/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS trivy-ci

LABEL org.opencontainers.image.title="OpenCTEM Sensor - Trivy CI"
LABEL org.opencontainers.image.description="Security scanning sensor with Trivy + preloaded vulnerability DB"
LABEL org.opencontainers.image.source="https://github.com/openctemio/sensor"

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy trivy from tool stage (its DB is copied once the user exists)
COPY --from=tool-with-db /usr/local/bin/trivy /usr/local/bin/

# Copy sensor binary
COPY --from=builder /out/openctemio-sensor /usr/local/bin/openctemio-sensor
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Non-root. uid/gid 1001 is the GitHub-hosted runner's user, which owns the
# checked-out workspace mounted at /github/workspace, so git's ownership
# check passes and reports can be written there. git trusts exactly that
# path (system config), not every directory ('*'). Elsewhere, run the
# container as the workspace owner (docker run --user "$(id -u):$(id -g)",
# GitLab: image:docker:user) or trust the checkout for the job, e.g.
# GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$CI_PROJECT_DIR".
RUN groupadd -g 1001 openctem && useradd -u 1001 -g openctem -d /home/openctem -m openctem \
    && git config --system --add safe.directory /github/workspace \
    && mkdir -p /github/workspace && chown openctem:openctem /github/workspace

ENV HOME=/home/openctem
# The preloaded DB, owned by the scan user (created above, so its HOME is
# its own) and not chowned in a second layer.
COPY --from=tool-with-db --chown=1001:1001 /root/.cache/trivy /home/openctem/.cache/trivy

ENV TRIVY_CACHE_DIR=/home/openctem/.cache/trivy
ENV TRIVY_NO_PROGRESS=true
ENV CI=true
USER openctem
WORKDIR /github/workspace
ENTRYPOINT ["/usr/local/bin/openctemio-sensor"]
CMD ["-tool", "trivy", "--help"]
